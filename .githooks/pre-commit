#!/bin/sh
# Refuse un commit qui casse l'analyse statique ou les tests.
#
# Versionné dans .githooks/ pour survivre à un clone, et activé par :
#   git config core.hooksPath .githooks
#
# Contourner ponctuellement : git commit --no-verify

set -e
cd "$(git rev-parse --show-toplevel)"

if [ ! -x .venv/bin/ruff ]; then
    echo "pre-commit : environnement absent, lancez 'uv sync --extra dev'." >&2
    exit 1
fi

echo "pre-commit : ruff…"
.venv/bin/ruff check src tests

# Fichier par fichier plutôt qu'en un bloc : en un seul processus, la
# QApplication, les widgets, les vignettes et les images d'export s'accumulent.
# Le pic mémoire passe de 177 à 142 Mo, pour deux secondes de plus.
echo "pre-commit : pytest…"
scripts/run_tests.sh

echo "pre-commit : ok"
